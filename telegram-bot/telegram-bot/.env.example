# --- Required ---
# Get this from @BotFather (see README, Step 1)
BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Your numeric Telegram user ID. Only this user can use admin commands like /signal.
# To find it: send /start to @userinfobot on Telegram.
ADMIN_USER_ID=123456789

# --- Optional ---
# Public channel where signals + news are also posted (e.g., @mychannel).
# Leave empty to send only to direct subscribers.
CHANNEL_ID=@yourchannelname

# Local time (Asia/Ho_Chi_Minh) at which the daily news digest is sent. 24h format HH:MM.
DAILY_NEWS_TIME=07:30

# Comma-separated list of news sources. Use RSS URLs when available — much more reliable.
# Note: ForexFactory blocks most automated requests to its RSS endpoint, so the
# defaults below use feeds that work reliably out of the box. You can add or
# replace any URL here. Plain HTML pages also work but are less stable.
NEWS_SOURCES=https://www.investing.com/rss/news_1.rss,https://www.forexlive.com/feed/,https://www.financemagnates.com/feed/

# Max number of headlines per daily digest
NEWS_MAX_ITEMS=8

# Where SQLite stores subscribers + de-duplication state
DB_PATH=/data/bot.db


# =============================================================================
# TradingView Webhook Receiver (paid plan: Essential / Plus / Premium)
# =============================================================================
# Off by default. When enabled, the bot opens an HTTP server that accepts
# POSTs from TradingView at:  https://yourdomain.com/tv-webhook/<WEBHOOK_SECRET>
#
# In TradingView's alert dialog, set the Webhook URL to that full path,
# and put your alert payload (JSON or text) in the Message box.
WEBHOOK_ENABLED=false
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
# Generate a strong secret: python -c 'import secrets; print(secrets.token_urlsafe(32))'
WEBHOOK_SECRET=


# =============================================================================
# Email Bridge (works with TradingView free plan)
# =============================================================================
# Off by default. When enabled, the bot polls an IMAP mailbox you control,
# parses TradingView alert emails, and broadcasts them as signals.
#
# Gmail setup:
#   1. Enable 2-Step Verification on the Google account.
#   2. Create an App Password (Google Account > Security > App passwords).
#   3. Use that 16-char password below as IMAP_PASSWORD.
#   4. In TradingView, enable "Send email" on each alert (free plan supports this).
EMAIL_BRIDGE_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@gmail.com
IMAP_PASSWORD=your-16-char-app-password
# Only forward emails from this sender (substring match). Leave empty to forward any unread email.
IMAP_SENDER_FILTER=noreply@tradingview.com
# Poll interval in seconds. Lower = lower latency but more IMAP traffic.
IMAP_POLL_SECONDS=20
